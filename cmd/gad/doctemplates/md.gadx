/**
md.gadx — default Markdown documentation template for `gad doc`.

It receives the extracted documentation as `param (doc dict)` and writes
Markdown to STDOUT. `doc` is:

    { name: str, file: str, lang: str, source: str, prose: str,
      sections: [ { title: str,
        symbols: [ { name, signature, doc, meta: str, line, column: int,
                     overloads: [ { signature, doc } ],
                     members: [ { group, signature, meta, doc } ] } ] } ] }

`meta` is a declaration's `[k=v, …]` metadata tag (shown above its signature);
`members` are a type's fields/properties/constructors/methods/requirements.

`name`/`file`/`lang`/`source` are added by the CLI (the module base name, the
source file name, its fence language and the full source). The rendered page
is the feature's prose followed by its documented symbols and the complete,
runnable example — one source of truth: the sample file itself.

This template is intentionally a plain script inside a `~~ … ~~` block: it
writes Markdown directly with `write()`, no HTML involved. Because `write` is
a core builtin (not gadx-only), the same body also works as a `.gad`/`.gadt`
template.
**/
~~
param (doc dict)

// The prose of a migrated sample leads with its own `# Title`; only synthesize a
// `# name` heading when it does not.
if !doc.proseHasTitle {
    write("# " + doc.name + "\n")
}

if doc.prose {
    write("\n" + doc.prose + "\n")
}

for sec in doc.sections {
    write("\n## " + sec.title + "\n")
    for s in sec.symbols {
        write("\n### " + s.name + "\n")
        // The typed signature (function params + return, or a const's `= value`)
        // goes right below the heading, in a fenced code block so it highlights;
        // the `[k=v, …]` metadata tag, when present, sits on the line above it.
        if s.signature || s.meta {
            code := s.name + s.signature
            if s.meta {
                code = s.meta + "\n" + code
            }
            write("\n```" + doc.lang + "\n" + code + "\n```\n")
        }
        if s.doc {
            write("\n" + s.doc + "\n")
        }
        // A type's members, grouped by kind, each with its metadata tag and doc.
        group := ""
        for m in s.members {
            if m.group != group {
                group = m.group
                write("\n#### " + group + "\n")
            }
            code := m.signature
            if m.meta {
                code = m.meta + "\n" + code
            }
            write("\n```" + doc.lang + "\n" + code + "\n```\n")
            if m.doc {
                write("\n" + m.doc + "\n")
            }
        }
        // A multi-signature function renders one fenced block + doc per overload.
        for o in s.overloads {
            write("\n```" + doc.lang + "\n" + s.name + o.signature + "\n```\n")
            if o.doc {
                write("\n" + o.doc + "\n")
            }
        }
    }
}

if doc.source {
    // `doc.fence` is wide enough to wrap any backticks inside the source (e.g. a
    // doctest ``` fence embedded in a doc comment).
    write("\n## Example — `" + doc.file + "`\n")
    write("\n" + doc.fence + doc.lang + "\n" + doc.source)
    if doc.source[len(doc.source)-1] != '\n' {
        write("\n")
    }
    write(doc.fence + "\n")
}
~~
