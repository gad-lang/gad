/**
html.gadx — default HTML documentation template for `gad doc`.

It receives the extracted documentation as `param (doc dict)` and renders a
self-contained HTML fragment. `doc` is:
  { name: str, file: str, lang: str, source: str, prose: str,
    sections: [ { title: str,
      symbols: [ { name, signature, doc: str, line, column: int } ] } ] }

Each symbol carries data-line / data-column attributes so an editor can jump
to the source position. The full example source is rendered as a <pre><code>
block so the generated page is self-contained.
**/

@param (doc dict)

@main
    article.gad-doc
        @if !doc.proseHasTitle
            h1 {doc.name}

        @if doc.prose
            p.prose {doc.prose}

        @for sec in doc.sections
            section.doc-section
                h2 {sec.title}

                @for s in sec.symbols
                    div.symbol[data-line=s.line, data-column=s.column]
                        h3
                            code {s.name}

                        @if s.signature
                            p.signature
                                code {s.name + s.signature}

                        @if s.doc
                            p.doc {s.doc}

                        @for o in s.overloads
                            p.signature
                                code {s.name + o.signature}
                            @if o.doc
                                p.doc {o.doc}

        @if doc.source
            section.doc-example
                h2
                    | Example —
                    code {doc.file}
                pre
                    code[class="language-" + doc.lang] {doc.source}
