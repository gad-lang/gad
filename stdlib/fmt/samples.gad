// Samples of module fmt: one `example NAME { … }` per exported
// member. Their checks (`= EXPR`, `<<< text`) are verified when `gad doc` runs
// the file, and gaddoc merges them into the module API as `## Example` sections
// (the `gad:samples` directive).

example print {
    // print writes to stdout and returns the byte count: the return checked
    // first, then what was printed
    fmt.print("a", 1)
    = 2
    <<< a1
}

example printf {
    fmt.printf("%d!", 5)
    = 2
    <<< 5!
}

example println {
    fmt.println("hi", 1)
    = 5
    <<< hi 1
}

example sprint {
    fmt.sprint("x=", 5)
    = "x=5"
}

example sprintf {
    fmt.sprintf("%s=%d", "n", 42)
    = "n=42"
}

example sprintln {
    fmt.sprintln("a", 1)
    = "a 1\n"
}

example sscan {
    fmt.sscan("7", fmt.scanArg("int"))
    = 1
}

example sscanf {
    // scanArg holders receive the parsed fields; sscanf returns the count.
    fmt.sscanf("42 hi", "%d %s", fmt.scanArg("int"), fmt.scanArg("str"))
    = 2
}

example scanArg {
    // scanArg builds a typed holder passed to sscan/sscanf.
    typeName(fmt.scanArg("int"))
    = "scanArg"
}
