// Samples of module strings: one `example NAME { … }` per exported
// member. Their checks (`= EXPR`, `<<< text`) are verified when `gad doc` runs
// the file, and gaddoc merges them into the module API as `## Example` sections
// (the `gad:samples` directive).

example contains {
    strings.contains("hello", "ell")
    = true
}

example containsAny {
    strings.containsAny("hello", "aeiou")
    = true
}

example containsChar {
    strings.containsChar("hello", "e"[0])
    = true
}

example count {
    strings.count("banana", "a")
    = 3
}

example equalFold {
    strings.equalFold("Go", "GO")
    = true
}

example fields {
    strings.fields("  a b   c ")
    = ["a", "b", "c"]
}

example fieldsFunc {
    strings.fieldsFunc("a1b2c", func(c) => c >= "0"[0] && c <= "9"[0])
    = ["a", "b", "c"]
}

example hasPrefix {
    strings.hasPrefix("gopher", "go")
    = true
}

example hasSuffix {
    strings.hasSuffix("gopher", "her")
    = true
}

example index {
    strings.index("chicken", "ken")
    = 4
}

example indexAny {
    strings.indexAny("golang", "ln")
    = 2
}

example indexByte {
    strings.indexByte("golang", "g"[0])
    = 0
}

example indexChar {
    strings.indexChar("golang", "a"[0])
    = 3
}

example indexFunc {
    strings.indexFunc("go123", func(c) => c >= "0"[0] && c <= "9"[0])
    = 2
}

example join {
    strings.join(["a", "b", "c"], "-")
    = "a-b-c"
}

example joinAnd {
    strings.joinAnd(["a", "b", "c"], ", ", " and ")
    = "a, b and c"
}

example lastIndex {
    strings.lastIndex("go gopher", "go")
    = 3
}

example lastIndexAny {
    strings.lastIndexAny("golang", "ln")
    = 4
}

example lastIndexByte {
    strings.lastIndexByte("golang", "g"[0])
    = 5
}

example lastIndexFunc {
    strings.lastIndexFunc("1a2b", func(c) => c >= "0"[0] && c <= "9"[0])
    = 2
}

example dict {
}

example padLeft {
    strings.padLeft("7", 3, "0")
    = "007"
}

example padRight {
    strings.padRight("7", 3, "0")
    = "700"
}

example repeat {
    strings.repeat("ab", 3)
    = "ababab"
}

example replace {
    strings.replace("oink oink", "k", "ky", 2)
    = "oinky oinky"
}

example split {
    strings.split("a,b,c", ",", -1)
    = ["a", "b", "c"]
}

example splitAfter {
    strings.splitAfter("a,b,c", ",", -1)
    = ["a,", "b,", "c"]
}

example title {
    strings.title("hello world")
    = "Hello World"
}

example toLower {
    strings.toLower("Go")
    = "go"
}

example toTitle {
    strings.toTitle("hello")
    = "HELLO"
}

example toUpper {
    strings.toUpper("go")
    = "GO"
}

example toValidUTF8 {
    strings.toValidUTF8("abc", "?")
    = "abc"
}

example trim {
    strings.trim("xxhixx", "x")
    = "hi"
}

example trimFunc {
    strings.trimFunc("12hi34", func(c) => c >= "0"[0] && c <= "9"[0])
    = "hi"
}

example trimLeft {
    strings.trimLeft("xxhi", "x")
    = "hi"
}

example trimLeftFunc {
    strings.trimLeftFunc("12hi", func(c) => c >= "0"[0] && c <= "9"[0])
    = "hi"
}

example trimPrefix {
    strings.trimPrefix("gopher", "go")
    = "pher"
}

example trimRight {
    strings.trimRight("hixx", "x")
    = "hi"
}

example trimRightFunc {
    strings.trimRightFunc("hi12", func(c) => c >= "0"[0] && c <= "9"[0])
    = "hi"
}

example trimSpace {
    strings.trimSpace("  hi  ")
    = "hi"
}

example trimSuffix {
    strings.trimSuffix("gopher", "her")
    = "gop"
}

example trunc {
    strings.trunc("hello world", 8)
    = "hello wo..."
}

example slitWords {
    strings.slitWords("foo bar baz")
    = ["foo", "bar", "baz"]
}

example truncWords {
    strings.truncWords("one two three", 10)
    = "one two..."
}
