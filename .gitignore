#hidden files
.*
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.goreleaser.yml
# sample workspace config (.gad/) is part of the docs/examples
!/samples/.gad/
!/samples/.gad/**

# repl binary
/gad
/cmd/gad/gad
/dist/
# stray command binaries from `go build ./cmd/<name>/` at the repo root
/build-website
/update-vscode-plugin
/gaddoc

# editor plugin build artifacts (plugins/js/*, plugins/vscode-gad)
/plugins/**/node_modules/
/plugins/**/dist/
/plugins/**/out/
/plugins/**/*.tsbuildinfo
/plugins/**/*.vsix
/plugins/**/build/
/plugins/**/.gradle/
/plugins/**/.kotlin/
# goreleaser WASM release assets (built by scripts/build-wasm.sh)
/wasm-assets/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
# Profiling files
*.prof

/TODO*
/gaddoc

# skip generated doc of samples
/samples/doc
