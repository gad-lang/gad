//- html.giom — HTML documentation template for `gad doc`.
//-
//- It receives the extracted documentation as `param (doc dict)` and renders a
//- self-contained HTML fragment. `doc` is:
//-   { prose: str, sections: [ { title: str,
//-       symbols: [ { name, signature, doc: str, line, column: int } ] } ] }
//-
//- Each symbol carries data-line / data-column attributes so an editor can jump
//- to the source position.

@param (doc dict)

@main
    article.gad-doc
        @if doc.prose
            p.prose {doc.prose}

        @for sec in doc.sections
            section.doc-section
                h2 {sec.title}

                @for s in sec.symbols
                    div.symbol[data-line=s.line, data-column=s.column]
                        h3
                            code {s.name}
                            | {s.signature}

                        @if s.doc
                            p.doc {s.doc}
