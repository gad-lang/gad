{
  "name": "@gad-lang/ide-vuetify-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-less in-browser demo for @gad-lang/ide-vuetify: the reusable Vuetify IDE driven by a WASM + LocalStorage backend (no Go server).",
  "scripts": {
    "samples": "bun run scripts/gen-samples.ts",
    "wasm": "bash scripts/build-wasm.sh",
    "predev": "bun run samples",
    "dev": "vite",
    "build": "bun run samples && vue-tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gad-lang/codemirror-gad": "workspace:*",
    "@gad-lang/ide-vuetify": "workspace:*",
    "@gad-lang/prism-gad": "workspace:*",
    "@lezer/common": "^1.5.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "@mdi/font": "^7.4.47",
    "dockview-core": "^7.0.4",
    "dockview-vue": "^7.0.4",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.0",
    "vue": "^3.4.0",
    "vuetify": "^3.8.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
