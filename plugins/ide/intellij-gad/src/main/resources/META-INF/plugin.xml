<idea-plugin>
    <id>dev.gad-lang.gad</id>
    <name>Gad Language</name>
    <vendor url="https://gad-lang.github.io">Gad Lang</vendor>

    <description><![CDATA[
        Language support for <b>Gad</b>, a fast embeddable scripting language,
        and its template dialects, for JetBrains IDEs.
        <ul>
          <li>Syntax highlighting for .gad, .gadt and .gadx.</li>
          <li>Run configurations with execution profiles (arguments, working directory, environment, GADPATH).</li>
          <li>Full debugger over the Gad Debug Adapter (gad debug --dap): breakpoints and conditional breakpoints,
              call stack, step in/over/out, resume/pause, variables inspection, expression evaluation and navigation into imported files.</li>
          <li>Schema validation for .gad.yaml / .gadide.yaml project config.</li>
        </ul>
        See https://gad-lang.github.io
    ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="gad-textmate.xml">org.jetbrains.plugins.textmate</depends>
    <depends optional="true" config-file="gad-json.xml">com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Gad" language="Gad" extensions="gad"
                  implementationClass="dev.gad.intellij.lang.GadFileType" fieldName="INSTANCE"/>
        <fileType name="Gad Template" language="Gad" extensions="gadt"
                  implementationClass="dev.gad.intellij.lang.GadTemplateFileType" fieldName="INSTANCE"/>
        <fileType name="Gadx" language="Gad" extensions="gadx"
                  implementationClass="dev.gad.intellij.lang.GadxFileType" fieldName="INSTANCE"/>

        <!-- *_test.gad files get the Gad icon with a test badge. -->
        <fileIconProvider implementation="dev.gad.intellij.lang.GadFileIconProvider"/>

        <applicationService serviceImplementation="dev.gad.intellij.settings.GadSettings"/>
        <!-- Settings > Build, Execution, Deployment > Gad, with three child pages. -->
        <applicationConfigurable parentId="build"
                                 instance="dev.gad.intellij.settings.GadSettingsConfigurable"
                                 id="dev.gad.intellij.settings" displayName="Gad"/>
        <applicationConfigurable parentId="dev.gad.intellij.settings"
                                 instance="dev.gad.intellij.settings.GadExecutableConfigurable"
                                 id="dev.gad.intellij.settings.executable" displayName="Executable"/>
        <applicationConfigurable parentId="dev.gad.intellij.settings"
                                 instance="dev.gad.intellij.settings.GadPathConfigurable"
                                 id="dev.gad.intellij.settings.gadpath" displayName="GADPATH"/>
        <applicationConfigurable parentId="dev.gad.intellij.settings"
                                 instance="dev.gad.intellij.settings.GadFormattingConfigurable"
                                 id="dev.gad.intellij.settings.formatting" displayName="Formatting"/>

        <configurationType implementation="dev.gad.intellij.run.GadRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.gad.intellij.run.GadRunConfigurationProducer"/>
        <programRunner implementation="dev.gad.intellij.debug.GadDebugRunner"/>

        <xdebugger.breakpointType implementation="dev.gad.intellij.debug.GadBreakpointType"/>

        <!-- Reformat Code runs `gad fmt` for Gad files. -->
        <formattingService implementation="dev.gad.intellij.format.GadFormattingService"/>
        <notificationGroup id="Gad" displayType="BALLOON"/>

        <!-- Side panel: live-rendered documentation of the active Gad file. -->
        <toolWindow id="Gad Doc" anchor="right" secondary="true"
                    icon="dev.gad.intellij.lang.GadIcons.LOGO"
                    factoryClass="dev.gad.intellij.doc.GadDocToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Right-click a .gad/.gadt/.gadx file: Run it directly. -->
        <action id="dev.gad.intellij.run.GadRunFileAction"
                class="dev.gad.intellij.run.GadRunFileAction" text="Run" description="Run this Gad file">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <!-- Right-click a .gadt/.gadx file or a directory: transpile to .gad. -->
        <action id="dev.gad.intellij.run.GadTranspileAction"
                class="dev.gad.intellij.run.GadTranspileAction" text="Gad Transpile"
                description="Transpile Gad templates (.gadt / .gadx) to .gad">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after"
                          relative-to-action="dev.gad.intellij.run.GadRunFileAction"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="dev.gad.intellij.run.GadRunFileAction"/>
        </action>
        <!-- Right-click a .gad/.gadt/.gadx file: open the live Gad Doc panel. -->
        <action id="dev.gad.intellij.doc.GadDocAction"
                class="dev.gad.intellij.doc.GadDocAction" text="Gad Doc"
                description="Show this Gad file's documentation in the Gad Doc panel">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after"
                          relative-to-action="dev.gad.intellij.run.GadTranspileAction"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="dev.gad.intellij.run.GadTranspileAction"/>
        </action>
    </actions>
</idea-plugin>
