{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gadx",
  "scopeName": "source.gadx",
  "patterns": [
    { "include": "#comment" },
    { "include": "#doctype" },
    { "include": "#codeblock" },
    { "include": "#slot" },
    { "include": "#keyword" },
    { "include": "#component" },
    { "include": "#pipe" },
    { "include": "#html" },
    { "include": "#interpolation" },
    { "include": "#tag" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*//.*$",
      "name": "comment.line.double-slash.gadx"
    },
    "doctype": {
      "match": "^\\s*(!!!).*$",
      "name": "keyword.other.doctype.gadx"
    },
    "codeblock": {
      "begin": "^\\s*(~~)\\s*$",
      "beginCaptures": { "1": { "name": "punctuation.definition.codeblock.gadx" } },
      "end": "^\\s*(~~)\\s*$",
      "endCaptures": { "1": { "name": "punctuation.definition.codeblock.gadx" } },
      "name": "meta.embedded.block.gad",
      "patterns": [{ "include": "source.gad" }]
    },
    "interpolation": {
      "begin": "\\{=?",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.gadx" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.gadx" } },
      "name": "meta.interpolation.gadx",
      "patterns": [{ "include": "source.gad" }]
    },
    "slot": {
      "begin": "^(\\s*)(@slot)(?=\\s+#?\")",
      "beginCaptures": { "2": { "name": "keyword.control.gadx" } },
      "end": "$",
      "patterns": [
        { "match": "#", "name": "punctuation.definition.slot.pass.gadx" },
        { "include": "#slotname" },
        { "include": "source.gad" }
      ]
    },
    "slotname": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.gadx" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.gadx" } },
      "patterns": [
        { "include": "#interpolation" },
        { "match": "[^{\"]+", "name": "string.quoted.double.gadx" }
      ]
    },
    "keyword": {
      "begin": "^(\\s*)(@[A-Za-z_]\\w*)",
      "beginCaptures": { "2": { "name": "keyword.control.gadx" } },
      "end": "$",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "source.gad" }
      ]
    },
    "component": {
      "begin": "^(\\s*)(\\+[A-Za-z_][\\w.]*)",
      "beginCaptures": { "2": { "name": "entity.name.function.gadx" } },
      "end": "$",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "source.gad" }
      ]
    },
    "pipe": {
      "begin": "^(\\s*)(\\|)",
      "beginCaptures": { "2": { "name": "punctuation.definition.text.gadx" } },
      "end": "$",
      "name": "string.unquoted.text.gadx",
      "patterns": [{ "include": "#interpolation" }]
    },
    "html": {
      "begin": "^\\s*(?=<)",
      "end": "$",
      "name": "meta.tag.html.gadx",
      "patterns": [
        { "include": "#interpolation" },
        { "match": "</?", "name": "punctuation.definition.tag.gadx" },
        { "match": ">", "name": "punctuation.definition.tag.gadx" },
        { "match": "\\b([A-Za-z][\\w-]*)\\s*=", "captures": { "1": { "name": "entity.other.attribute-name.gadx" } } },
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.gadx" },
        { "begin": "'", "end": "'", "name": "string.quoted.single.gadx" },
        { "match": "\\b[A-Za-z][\\w-]*", "name": "entity.name.tag.gadx" }
      ]
    },
    "tag": {
      "begin": "^(\\s*)([A-Za-z][\\w-]*)?",
      "beginCaptures": { "2": { "name": "entity.name.tag.gadx" } },
      "end": "$",
      "name": "meta.tag.gadx",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#attributes" },
        { "match": "\\.[A-Za-z0-9_-]+", "name": "entity.other.attribute-name.class.gadx" },
        { "match": "#[A-Za-z0-9_-]+", "name": "entity.other.attribute-name.id.gadx" }
      ]
    },
    "attributes": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.definition.attributes.begin.gadx" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.definition.attributes.end.gadx" } },
      "name": "meta.attributes.gadx",
      "patterns": [{ "include": "source.gad" }]
    }
  }
}
